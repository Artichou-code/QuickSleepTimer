<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#262E42"
                android:startColor="#404C6A"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke
                android:width="2.5dp"
                android:color="@color/tv_border_focused" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#262E42"
                android:startColor="#404C6A"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke
                android:width="2.5dp"
                android:color="@color/tv_border_focused" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#0F1118"
                android:startColor="#191C28"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/tv_border_hairline" />
        </shape>
    </item>
</selector>
