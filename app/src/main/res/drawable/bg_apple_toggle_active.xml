<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#154532"
                android:startColor="#256B4E"
                android:type="linear" />
            <corners android:radius="999dp" />
            <stroke
                android:width="2.5dp"
                android:color="@color/tv_border_focused" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#0F2C20"
                android:startColor="#1A4A36"
                android:type="linear" />
            <corners android:radius="999dp" />
            <stroke
                android:width="1.2dp"
                android:color="@color/tv_emerald_border" />
        </shape>
    </item>
</selector>
